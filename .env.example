# Frontend Variables
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Restaurant01
VITE_APP_VERSION=0.1.0

# Host port to map to the nginx container (used by docker-compose)
# Example: FRONTEND_PORT=8080
FRONTEND_PORT=8080

# Backend should have its own .env in backend/.env with:
# PORT=5000
# NODE_ENV=development
# MONGODB_URI=...
# JWT_SECRET=...
# JWT_EXPIRES_IN=7d
# FRONTEND_URL=http://localhost:3000
